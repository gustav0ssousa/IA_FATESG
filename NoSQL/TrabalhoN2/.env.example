
# Django settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENVIRONMENT=local
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False

# API security (leave empty only in trusted local environments)
API_ACCESS_KEY=
API_REQUIRE_AUTHENTICATION=False
API_ANON_THROTTLE_RATE=120/min
API_USER_THROTTLE_RATE=600/min

# Database settings
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db

# RAG settings
DOCUMENT_MAX_UPLOAD_SIZE=78643200
DOCUMENT_STORAGE_DIR=backend/media
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=/tmp/fastembed_cache
EMBEDDING_THREADS=1
EMBEDDING_ENABLE_CPU_MEM_ARENA=False
EMBEDDING_SERVICE_URL=
EMBEDDING_SERVICE_ENABLED=False
EMBEDDING_SERVICE_TIMEOUT_SECONDS=180

# Qdrant settings
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=12000

# Maritaca API settings
MARITACA_API_KEY=
MARITACA_BASE_URL=https://chat.maritaca.ai/api
MARITACA_MODEL=sabia-4
MARITACA_TEMPERATURE=0.1
MARITACA_MAX_OUTPUT_TOKENS=1024
MARITACA_TIMEOUT_SECONDS=60
MARITACA_MAX_RETRIES=2

# Asynchronous indexing settings
RABBITMQ_DEFAULT_USER=rag_user
RABBITMQ_DEFAULT_PASS=rag_password
CELERY_BROKER_URL=amqp://rag_user:rag_password@localhost:5672//
CELERY_INDEXING_MAX_RETRIES=3

# Observability settings
AUDIT_STORE_QUESTION_TEXT=False
AUDIT_RETENTION_DAYS=90
OBSERVABILITY_EXPOSE_QUESTION_TEXT=False
